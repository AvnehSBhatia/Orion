# OpenRouter (server side only). Runs extraction and the built-in assistant.
OPENROUTER_API_KEY=
# Any OpenRouter model with tools and structured outputs. DeepSeek V4 Flash is cheap and fast; V4 Pro is stronger.
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_EXTRACT_MODEL=deepseek/deepseek-v4-flash

# Embeddings. gemma (default) runs EmbeddingGemma 2 in process with the text and vision encoders
# (pages embed together with their screenshots), no key.
# openrouter uses OPENROUTER_EMBED_MODEL. local is a hashing embedder for offline tests only.
EMBED_PROVIDER=gemma
GEMMA_MODEL=onnx-community/embeddinggemma-2-ONNX
# q8 (default) | q4 (smaller, faster) | fp32. Never fp16: the model overflows it.
GEMMA_DTYPE=q8
MODEL_CACHE_DIR=.cache/models

OPENROUTER_EMBED_MODEL=google/gemini-embedding-2
EMBED_DIMENSIONS=768

# Storage: one SQLite file per org at $DATA_DIR/orgs/<orgId>.db
DATA_DIR=data

# CORS: comma separated UI origins. chrome-extension:// origins are always allowed.
UI_ORIGIN=http://localhost:3000
