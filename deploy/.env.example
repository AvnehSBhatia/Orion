# Orion production settings. Used by deploy/docker-compose.yml (copy to deploy/.env) and by the
# systemd setup (copied to /etc/orion/orion.env). Keep the real file mode 600; it holds secrets.

# --- Box ---------------------------------------------------------------------
# The dashboard is served at app.<ORION_DOMAIN> and the API at api.<ORION_DOMAIN>.
ORION_DOMAIN=example.com
# Let's Encrypt account email (expiry warnings).
ACME_EMAIL=ops@example.com

# --- Model provider -------------------------------------------------------------
# Create the key with data collection denied (see docs/launch-checklist.md). Rotate: docs/runbook.md.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_FAST_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_EXTRACT_MODEL=anthropic/claude-haiku-5.5

# --- Embeddings -----------------------------------------------------------------
# gemma: EmbeddingGemma in the API process. q8 with image embeds needs a 4GB box (~2GB peak on an image).
# openrouter: embeddings via OpenRouter; fits a 1-2GB box. Page text then goes to the embedding provider.
# A 2GB box can run gemma with GEMMA_DTYPE=q4 and EMBED_SCREENSHOTS=never (Mac captures have no screenshots):
# ~1.0GB peak, retrieval within a few points of gemini-embedding-2, no embedding bill. Keep the swap the setup script adds.
EMBED_PROVIDER=gemma
OPENROUTER_EMBED_MODEL=google/gemini-embedding-2
EMBED_DIMENSIONS=768
GEMMA_DTYPE=q4
EMBED_SCREENSHOTS=never
INGEST_IMAGES=light

# --- Auth and browser access ----------------------------------------------------------
# The compose file forces COOKIE_SECURE=true, TRUST_PROXY=true, AUTH_DISABLED=false and
# UI_ORIGIN=https://app.<ORION_DOMAIN>. The systemd setup writes the same values below.
COOKIE_SECURE=true
TRUST_PROXY=true
AUTH_DISABLED=false
ALLOW_SIGNUP=false
UI_ORIGIN=https://app.example.com
# Chrome extension ids allowed to call the API (from chrome://extensions or the Web Store listing). Required.
EXTENSION_IDS=

# --- Background work --------------------------------------------------------------
MAINTAIN_INTERVAL_MS=60000

# --- Docker only ------------------------------------------------------------------
# Image tag for both images; set it to a git sha or release to make rollback a one-liner.
ORION_VERSION=latest
SERVER_MEM_LIMIT=3g
WEB_MEM_LIMIT=512m
# Host directory mounted at /backups in the server container.
BACKUP_HOST_DIR=./backups

# DATA_DIR and MODEL_CACHE_DIR are set by the compose file (/data, /models) and the systemd unit
# (/var/lib/orion/data, /var/lib/orion/models). Don't set them here.
