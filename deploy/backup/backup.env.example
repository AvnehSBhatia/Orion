# Orion backup settings. systemd install: /etc/orion/backup.env (root:orion, mode 640).
# Docker host: export these in the cron line, or `set -a; . ./backup.env; set +a` before orion-backup.sh.

# rclone destination. Configure the remote first: sudo -u orion rclone config --config /etc/orion/rclone.conf
# Recommended: wrap the bucket in an rclone "crypt" remote so backups are encrypted before they leave the box.
#   S3:  s3remote:acme-orion-backups/prod
#   B2:  b2remote:acme-orion-backups/prod
#   R2:  r2remote:acme-orion-backups/prod     (in rclone, R2 is an "s3" remote with provider = Cloudflare)
#   crypt over any of them: orion-crypt:prod
RCLONE_REMOTE=
RCLONE_CONFIG=/etc/orion/rclone.conf
# Days to keep offsite (0 = never delete here; use a bucket lifecycle rule or object lock instead).
RCLONE_KEEP_DAYS=35

# Days to keep on the box.
BACKUP_KEEP_DAYS=7

# Optional dead man's switch (healthchecks.io, Better Stack heartbeat, ...). Alerts when a run fails or never happens.
HEALTHCHECK_URL=
