# OpenRouter (server side only). Runs extraction and the built-in assistant.
OPENROUTER_API_KEY=
# Any OpenRouter model with tools and structured outputs. DeepSeek V4 Flash is cheap and fast; V4 Pro is stronger.
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_EXTRACT_MODEL=deepseek/deepseek-v4-flash

# Embeddings. gemma (default) runs EmbeddingGemma 2 in process with the text and vision encoders
# (pages embed together with their screenshots), no key.
# openrouter uses OPENROUTER_EMBED_MODEL. local is a hashing embedder for offline tests only.
EMBED_PROVIDER=gemma
GEMMA_MODEL=onnx-community/embeddinggemma-2-ONNX
# q8 (default) | q4 (smaller, faster) | fp32. Never fp16: the model overflows it.
GEMMA_DTYPE=q8
MODEL_CACHE_DIR=.cache/models

OPENROUTER_EMBED_MODEL=google/gemini-embedding-2
EMBED_DIMENSIONS=768

# Storage: one SQLite file per org at $DATA_DIR/orgs/<orgId>.db
DATA_DIR=data

# The web app's origin(s), comma separated: CORS, the CSRF check on cookie writes, and invite/reset links (first one).
# Production refuses localhost here.
UI_ORIGIN=http://localhost:3000

# Cost controls.
# When a capture's screenshot goes into its embedding. An image embed costs ~14x a text embed (~1.9s CPU, ~2GB peak RAM with gemma).
# auto: only captures with little text (desktop windows, screens); tabs embed their text and keep the screenshot for viewing.
EMBED_SCREENSHOTS=auto
SCREENSHOT_TEXT_MIN=400
# Minimum time between org maintenance runs (area labels, map retrain, clusters, digests).
MAINTAIN_INTERVAL_MS=60000

# Auth. Every API route needs a session cookie or `Authorization: Bearer <token>`.
# With NODE_ENV=production the server refuses to start with AUTH_DISABLED=true, COOKIE_SECURE!=true, empty EXTENSION_IDS,
# a localhost UI_ORIGIN, or no OPENROUTER_API_KEY (only a warning with EMBED_PROVIDER=gemma).
# Create the first admin: npx tsx scripts/account.ts create --username you --password '...' --org <orgId> --user <userId> --admin
AUTH_DISABLED=false     # true only for local demos
ALLOW_SIGNUP=false      # true lets anyone create an org at POST /api/auth/signup
COOKIE_SECURE=false     # true behind HTTPS (cookie becomes __Host-orion_session, adds HSTS)
TRUST_PROXY=false       # true behind a reverse proxy that sets X-Forwarded-For (login rate limit keys on client IP)
EXTENSION_IDS=          # comma separated Chrome extension ids allowed by CORS; empty allows none (any with AUTH_DISABLED=true)
LOG_REQUESTS=true       # one JSON line per API request on stdout
RATE_LIMIT=true         # per-token/IP token buckets (ingest 2/s burst 20, chat/ask/MCP 1/s burst 10); false for load tests

# Model provider reliability and privacy. Every request sends provider.data_collection=deny.
OPENROUTER_TIMEOUT_CHAT_MS=45000
OPENROUTER_TIMEOUT_EXTRACT_MS=60000
OPENROUTER_TIMEOUT_EMBED_MS=30000
OPENROUTER_MAX_RETRIES=3          # on 429, 5xx, network and HTTP/2 stream errors, with backoff and Retry-After
OPENROUTER_PROVIDERS=             # comma separated provider slugs allowed to serve requests (provider.only); empty: any
OPENROUTER_IGNORE_PROVIDERS=      # comma separated provider slugs never used (provider.ignore)
# Usage and budget (per org, llmMonthlyBudgetUsd in org settings). Cost is OpenRouter's usage.cost when returned,
# else these prices in USD per million tokens [input, output].
LLM_PRICES=                       # e.g. {"vendor/model":[0.1,0.4]}
LLM_DEFAULT_PRICE=1,4             # for models in neither table
EXTRACTION_MAX_ATTEMPTS=5         # background retries of a failed extraction before it is marked failed

# Background jobs (in process; one server process per DATA_DIR).
BACKGROUND_JOBS=on                # off disables retention and extraction retries
MAX_SCREENSHOT_GB_PER_ORG=5       # oldest screenshots are removed past this; 0 means no cap
EMBED_WARM=true                   # load the local embedding model at boot (false: on first use)

# Backups: npm run backup (online, safe while running). Ship BACKUP_DIR off the box.
BACKUP_DIR=backups
BACKUP_KEEP=14
