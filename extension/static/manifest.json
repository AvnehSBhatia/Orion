{
  "manifest_version": 3,
  "name": "Constellation",
  "description": "Shares your screen with your company context map every few seconds.",
  "version": "0.6.1",
  "action": { "default_popup": "popup.html", "default_title": "Constellation" },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "desktopCapture"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
