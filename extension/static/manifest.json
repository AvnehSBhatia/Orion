{
  "manifest_version": 3,
  "name": "Orion",
  "description": "Captures the windows, screens, and tabs you choose into your team's Orion context map.",
  "version": "0.6.1",
  "action": { "default_popup": "popup.html", "default_title": "Orion" },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "desktopCapture"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
